# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or use the interactive wizard:
#   bash scripts/setup-env.sh --env dev
#
# NEVER commit .env files — they contain secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/myapp_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5443/myapp_test
# When fronting Postgres with PgBouncer (staging/prod), DATABASE_URL points at the
# pooler (?pgbouncer=true); DIRECT_URL points straight at Postgres for migrations:
# DATABASE_URL=postgresql://postgres:postgres@localhost:6432/myapp_dev?pgbouncer=true
# DIRECT_URL=postgresql://postgres:postgres@localhost:5442/myapp_dev

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3333
CLIENT_PORT=4200
CLIENT_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# Auth — provider selected in PROJECT.md → auth_provider
# -----------------------------------------------------------------------------
# Better Auth (default). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-real-secret
BETTER_AUTH_URL=http://localhost:3333

# Optional: Zitadel (auth_provider: zitadel) — OIDC login + Management API queries
# ZITADEL_ISSUER=https://your-instance.zitadel.cloud
# ZITADEL_CLIENT_ID=xxxxxxxx
# ZITADEL_PROJECT_ID=xxxxxxxx
# ZITADEL_API_URL=https://your-instance.zitadel.cloud
# ZITADEL_SERVICE_ACCOUNT_KEY=./zitadel-key.json
# VITE_ZITADEL_ISSUER=https://your-instance.zitadel.cloud
# VITE_ZITADEL_CLIENT_ID=xxxxxxxx

# Optional: Hydra (hydra integration) — machine-to-machine / API token auth
# HYDRA_PUBLIC_URL=https://hydra-public.your-domain.com
# HYDRA_ADMIN_URL=https://hydra-admin.your-domain.com
# HYDRA_CLIENT_ID=xxxxxxxx
# HYDRA_CLIENT_SECRET=xxxxxxxx

# -----------------------------------------------------------------------------
# Optional: Email (Resend)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Optional: Payments (Stripe)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Optional: Storage (S3-compatible)
# -----------------------------------------------------------------------------
# S3_ENDPOINT=https://your-region.digitaloceanspaces.com
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_REGION=your-region

# -----------------------------------------------------------------------------
# Optional: AI / LLM
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Optional: Redis / Valkey (for BullMQ queues + caching)
# -----------------------------------------------------------------------------
# Valkey is a drop-in Redis replacement — the URL and client code are identical.
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Optional: Error tracking (error-tracking integration) — Sentry
# Verify with: node scripts/verify-observability.js
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Optional: Logging (logging integration) — pick ONE provider via /setup-project
# -----------------------------------------------------------------------------
# Provider: Axiom
# AXIOM_TOKEN=xaat-xxxxxxxx
# AXIOM_DATASET=your-app
# AXIOM_ORG_ID=your-org
# VITE_AXIOM_TOKEN=xaat-xxxxxxxx
# VITE_AXIOM_DATASET=your-app-web

# Provider: Grafana Cloud (Loki push for logs; OTel for metrics/traces if `tracing` enabled)
# GRAFANA_LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_USER=123456
# GRAFANA_CLOUD_API_KEY=glc_xxxxxxxx

# Provider: Better Stack (logs + uptime + incident management)
# BETTERSTACK_SOURCE_TOKEN=xxxxxxxx
# VITE_BETTERSTACK_SOURCE_TOKEN=xxxxxxxx

# -----------------------------------------------------------------------------
# Optional: Tracing (tracing integration) — OpenTelemetry
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-xxx.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.name=my-app-api

# -----------------------------------------------------------------------------
# Optional: Feature flags (feature-flags integration) — pick ONE provider
# -----------------------------------------------------------------------------
# Provider: GrowthBook
# GROWTHBOOK_API_KEY=xxxxxxxx
# VITE_GROWTHBOOK_CLIENT_KEY=xxxxxxxx
# Provider: Unleash
# UNLEASH_URL=https://unleash.your-domain.com/api
# UNLEASH_API_TOKEN=*:production.xxxxxxxx
# Provider: LaunchDarkly
# LAUNCHDARKLY_SDK_KEY=sdk-xxxxxxxx
# VITE_LAUNCHDARKLY_CLIENT_ID=xxxxxxxx

# -----------------------------------------------------------------------------
# Optional: Cloudflare Tunnel (expose local dev env via a public hostname)
# -----------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=xxxxxxxx
