{
  "env": {
    "CLAUDE_UNATTENDED": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit",
      "Write",
      "Bash(git fetch origin *)",
      "Bash(git ls-remote --heads origin *)",
      "Bash(git switch -c fix/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git branch -D fix/*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * --delete*)",
      "Bash(git tag *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr close*)",
      "Bash(gh pr review*)",
      "Bash(gh pr edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue edit*)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm dlx *)",
      "Bash(npm install *)",
      "Bash(npx prisma migrate *)",
      "Bash(pnpm nx run database:*)",
      "Bash(pnpm nx serve*)",
      "Bash(docker *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.husky/**)",
      "Write(./.husky/**)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./tools/**)",
      "Write(./tools/**)",
      "Edit(./biome.json)",
      "Edit(./nx.json)",
      "Edit(./jest.preset.js)",
      "Edit(./package.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./docker-compose.yml)",
      "Edit(./**/prisma/schema.prisma)",
      "Write(./**/prisma/migrations/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
